# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/qira_erp

# The schema connection. Only needed once company isolation has split the
# database roles (migration 111), because DATABASE_URL is then the restricted
# role that cannot create tables — and the application platform's deployer
# creates a company's tables when a generated application is deployed.
#
# Used by `npm run db:migrate` and by the deployer, and by nothing else. Leave
# it unset on a single-role database, where DATABASE_URL already owns the
# schema. Leave it unset with split roles and everything works except deploying
# an application, which refuses up front and names this variable.
# MIGRATION_DATABASE_URL=postgresql://owner:password@localhost:5432/qira_erp

# Scheduled automations declared by generated applications ("chase anything
# overdue, daily"). Off unless set to true: the actions it dispatches notify
# people, and starting a server should not.
# PLATFORM_SCHEDULER_ENABLED=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qira_erp
DB_USER=username
DB_PASSWORD=password

# --- docker-compose.yml (the self-hosted stack) -----------------------------
# `docker compose up` reads these from THIS file (copied to .env at the repo
# root), not from backend/.env — see docker-compose.yml's own header comment.
POSTGRES_DB=qira_erp
POSTGRES_USER=qira
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-24
# The app's own runtime DB role (not the Postgres owner above) — see
# docker/postgres-init/10-create-app-role.sh and migration 111. Required for
# company isolation (RLS) to actually be enforceable; docker-compose fails
# outright without it.
APP_DB_PASSWORD=generate-with-openssl-rand-hex-24
JWT_SECRET=generate-with-openssl-rand-base64-48
SUPPLIER_JWT_SECRET=generate-with-openssl-rand-base64-48
# Signs the embmis_sso cookie shared between embmis.com (landing) and the ERP
# at embmis.com/platform — see backend/services/ssoCookie.js.
SSO_COOKIE_SECRET=generate-with-openssl-rand-base64-48

# Server Configuration
NODE_ENV=development
PORT=3001

# AI Configuration
OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
# Optional: point at a custom OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1

# AI_PROVIDER=openrouter routes every Simeli AI feature — chat, vision/OCR,
# PDF reading, AI mail branding — through openrouter.ai's OpenAI-compatible
# API instead of OpenAI directly. Leave AI_MODEL / AI_VISION_MODEL below
# unset in that mode and they default to $0 ":free" OpenRouter models
# (see backend/config/aiConfig.js) — no other code change needed to switch.
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default model used by ALL Simeli AI features (GPT-5.6 Luna).
# Override this single value to move the whole ERP to another model.
AI_MODEL=gpt-5.6-luna
# Optional lighter tier for high-frequency utility calls (intent routing,
# classification). Defaults to AI_MODEL when unset.
AI_MODEL_FAST=gpt-5.6-luna
# Vision model for images, scanned PDFs, and the AI mail branding logo
# reader. Defaults to a DeepSeek vision model (or, with AI_PROVIDER=openrouter
# and this left unset, a free OpenRouter vision model) — see AI_VISION_MODEL
# in backend/config/aiConfig.js.
AI_VISION_MODEL=
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=800

# Finance / Tax
# Company default VAT rate (percent) applied to invoices when no per-customer
# rate is set. Example: 18 for 18% VAT. Leave 0 to disable default VAT.
DEFAULT_VAT_RATE=0
AI_REASONING_EFFORT=minimal
AI_VERBOSITY=low
AI_SYSTEM_PROMPT=You are Simeli AI, the intelligent assistant embedded in the Simeli ERP system. You help users manage inventory, procurement, sales, and finance. Answer clearly, concisely, and professionally. When you are unsure, say so honestly and suggest where the user can find the information in the ERP.

# JWT Configuration
JWT_SECRET=your_jwt_secret_here

# Internal service-to-service auth (optional). If set, a caller presenting the
# header  X-Internal-Service-Token: <this value>  is treated as a trusted system
# user. This replaces the old client-controlled X-AI-Service bypass. Leave BLANK
# to disable the service path entirely (recommended unless you actually need it).
INTERNAL_SERVICE_TOKEN=

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# --- Production domain (embmis.com) -----------------------------------------
# Only needed when running behind nginx/embmis.conf (docker compose --profile
# production) — embmis.com/ is the landing page (embmis-web), the ERP is at
# embmis.com/platform, one host, one nginx config. Leave these at their
# localhost defaults above for a plain `docker compose up` with no domain.
#
# BASE_URL/FRONTEND_URL: used to build links in outbound email, PDFs, and
# OAuth connector callback URLs (backend/services/emailService.js and
# others) — must include the /platform suffix, since that's this app's real
# public path in production.
# BASE_URL=https://embmis.com/platform
# FRONTEND_URL=https://embmis.com/platform
# VITE_API_URL: baked into the ERP frontend's build (Vite, BUILD time) — a
# relative path here means "wherever this page itself is served from",
# which nginx/embmis.conf's prefix-stripping then routes correctly without
# hardcoding the domain into the built bundle.
# VITE_API_URL=/platform/api
# Host port for the embmis-web (landing page) container — see the
# embmis-web service in docker-compose.yml.
EMBMIS_WEB_PORT=3002

# "Sign in with Google" — one Google Cloud Console OAuth Client ID, used by
# both apps (they're the same origin in production). Only a Client ID, no
# secret: this verifies a signed ID token (Google Identity Services), not a
# server-redirect code exchange. Leave all three unset to disable the Google
# button entirely everywhere; email/password still works.
#   Authorized JavaScript origins: https://embmis.com, plus
#   http://localhost:3000 and http://localhost:5173 for local testing.
GOOGLE_LOGIN_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# The platform owner — whoever operates this deployment, as opposed to an ADMIN
# of a company inside it. Grants the Administration → App Statistics screen,
# which reports instance-wide figures (request volume, database size, table
# sizes) that a customer's own administrator has no business reading.
#
# Matched against the logged-in user's email. Deliberately NOT a role or a
# column on `users`: nothing reachable through the product can grant it, so a
# tenant admin who can set any user's role still cannot make themselves the
# owner. Leave BLANK and nobody qualifies, including you.
PLATFORM_OWNER_EMAIL=
# --- EMBMIS Gateway (optional) -----------------------------------------------------------------
# Every action an AI takes (Simeli in chat, autonomous agents) is checked by EMBMIS Gateway before it
# happens. Leave EMBMIS_GATEWAY_URL empty and the gateway is off: behaviour is unchanged.
EMBMIS_GATEWAY_URL=
# Issued on the gateway host with `npm run platform-key`; it only provisions tenants and agents.
EMBMIS_GATEWAY_PLATFORM_KEY=
# Where "Open Gateway console" in Settings -> AI Gateway points. Defaults to EMBMIS_GATEWAY_URL.
EMBMIS_GATEWAY_CONSOLE_URL=
# What a write does when the gateway cannot be reached. Reads always continue.
#   closed (default): the write waits for a person.   open: the write runs.
EMBMIS_GATEWAY_FAIL_MODE=closed
EMBMIS_GATEWAY_TIMEOUT_MS=3000
# Each company's gateway agent key is stored encrypted with this (32 bytes, hex):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_VAULT_KEY=
