# EMBMIS ERP — production environment. Copy to .env.production (never commit it).
# Generate secrets on the server:  openssl rand -base64 48   |   openssl rand -hex 24   |   openssl rand -hex 32

# --- Database ---
POSTGRES_DB=qira_erp
POSTGRES_USER=qira
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# --- Secrets ---
JWT_SECRET=
SUPPLIER_JWT_SECRET=
SSO_COOKIE_SECRET=
# 32 bytes as 64 hex characters. Encrypts stored secrets, including the gateway agent key. Losing it means
# re-entering those secrets, so back it up with the database.
AI_VAULT_KEY=

# --- Addresses ---
# The public origin of the app (scheme and host, no path).
APP_ORIGIN=https://erp.example.com
# Empty: the app is served at the root of the host (web app at /, API at /api).
# Under a path of a shared host, e.g. /erp: the web app at /erp/, the API at /erp/api (built into the web bundle).
APP_BASE_PATH=
# The account that may see instance-wide statistics. Without it, the first signup becomes the platform owner.
PLATFORM_OWNER_EMAIL=

# --- EMBMIS Gateway (optional: leave EMBMIS_GATEWAY_URL empty to run without it) ---
# https://github.com/EMBMIS/gateway — every AI action is checked by the gateway before it runs.
EMBMIS_GATEWAY_URL=
EMBMIS_GATEWAY_CONSOLE_URL=
# From `npm run platform-key` on the gateway host; its hash goes in the gateway's SAG_PLATFORM_KEY_HASHES.
EMBMIS_GATEWAY_PLATFORM_KEY=
# closed: a write waits for a person when the gateway is unreachable. open: it runs. Reads always continue.
EMBMIS_GATEWAY_FAIL_MODE=closed
EMBMIS_GATEWAY_TIMEOUT_MS=3000

# --- Optional ---
OPENAI_API_KEY=
AI_MODEL=
AGENT_SCHEDULER_ENABLED=false
REPORT_SCHEDULER_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
