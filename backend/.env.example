# Simeli ERP — backend environment
#
# Copy to .env and fill in. Every value below is a placeholder; none of them are
# real credentials. Anything marked REQUIRED must be set or the server will not
# start correctly.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Where the API is reachable from outside — used to build links in email and PDFs.
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
# Comma-separated list of origins allowed to call the API. Defaults to FRONTEND_URL.
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Database — REQUIRED
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/qira_erp
# Set to true when the database requires TLS (most hosted Postgres does).
DB_SSL=false

# ---------------------------------------------------------------------------
# Authentication — REQUIRED
# ---------------------------------------------------------------------------
# Long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=8h
# Signs the tokens in supplier portal links. Separate from JWT_SECRET so that
# rotating one does not invalidate the other.
SUPPLIER_JWT_SECRET=replace_me_with_a_different_long_random_string
# Signs the embmis_sso browser cookie shared between embmis.com (landing) and
# the ERP under /platform — same origin in production, so this cookie needs
# no Domain/CORS setup, just its own secret (rotation-independence, same
# reasoning as SUPPLIER_JWT_SECRET above). REQUIRED — see services/ssoCookie.js.
SSO_COOKIE_SECRET=replace_me_with_a_different_long_random_string
# Lets trusted internal callers (the MCP server, schedulers) authenticate
# without a user session. Leave unset to disable that path entirely.
INTERNAL_SERVICE_TOKEN=

# ---------------------------------------------------------------------------
# AI providers
#
# AI_PROVIDER selects which backend the chat assistant and NL query use:
#   "openai" (default) — OpenAI or any OpenAI-compatible endpoint
#   "anthropic"        — Anthropic Claude models via the Messages API
#   "openrouter"       — OpenRouter (openrouter.ai), OpenAI-compatible. AI_MODEL
#                        and AI_VISION_MODEL default to $0 ":free" models when
#                        this is set and neither is overridden below — see
#                        config/aiConfig.js. Free-tier rate limits are real but
#                        generous; nothing here spends money unless you point
#                        AI_MODEL at a non-":free" OpenRouter model yourself.
#
# Set the corresponding API key for your chosen provider. The other keys
# may be left unset if you are only using one provider.
# ---------------------------------------------------------------------------
AI_PROVIDER=openai
# Point at any OpenAI-compatible endpoint. Leave unset for OpenAI itself.
OPENAI_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional custom base URL for Anthropic (e.g. a proxy). Leave unset.
ANTHROPIC_BASE_URL=
# openrouter.ai/keys. Only read when AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# Leave unset for OpenRouter itself; only for a self-hosted proxy in front of it.
OPENROUTER_BASE_URL=

# Model selection. AI_MODEL is the default for the active provider's path;
# AI_MODEL_FAST is used for short classification-style calls and falls back to
# AI_MODEL. AI_MODEL_ANTHROPIC is the default model when AI_PROVIDER=anthropic.
# AI_VISION_MODEL handles images and scanned-PDF pages (OCR, the AI mail
# branding logo reader) and needs to be a model that actually accepts image
# input — not every OpenRouter free model does.
# Leave AI_MODEL / AI_VISION_MODEL blank to use the free-tier OpenRouter
# defaults when AI_PROVIDER=openrouter (see config/aiConfig.js); set them
# explicitly to pick a specific model instead, free or otherwise.
AI_MODEL=gpt-5.6-luna
AI_MODEL_FAST=
AI_MODEL_ANTHROPIC=claude-sonnet-4-20250514
AI_VISION_MODEL=
AI_MAX_TOKENS=16000
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=2
AI_REASONING_EFFORT=medium
AI_VERBOSITY=medium
# How many chat sessions are held in memory before the oldest are evicted.
AI_CHAT_MAX_SESSIONS=500

# Optional: web search for the assistant. Without it, web lookups are disabled
# rather than silently answered from the model's own knowledge.
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# API key vault — REQUIRED to store any credential through the UI
#
# Encrypts stored third-party API keys (AES-256-GCM). Without it the vault
# refuses to store anything rather than falling back to plaintext, so the
# credential screens will not work. Deliberately NOT derived from JWT_SECRET:
# rotating a session secret must not destroy stored credentials.
#
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Keep a backup. If this value is lost, every stored credential must be
# re-entered — they cannot be recovered.
# ---------------------------------------------------------------------------
AI_VAULT_KEY=

# ---------------------------------------------------------------------------
# Autonomous agents
#
# Agents send email, draft documents and post transactions. The scheduler stays
# off unless this is exactly "true", so that importing the app in a test or a
# one-off script cannot start real unattended work.
# ---------------------------------------------------------------------------
AGENT_SCHEDULER_ENABLED=false
REPORT_SCHEDULER_ENABLED=false

# Where generated PDFs are written. Defaults to a directory inside the backend;
# set this to a mounted volume in production so documents survive a redeploy.
AI_DOCUMENTS_DIR=

# The user id the MCP server acts as. Required only when running `npm run mcp`.
MCP_ERP_USER_ID=

# ---------------------------------------------------------------------------
# Email (SMTP) — Gmail
#
# Gmail requires an "App Password", not your regular account password:
#   1. Enable 2-Step Verification on the Google account (required first).
#   2. Generate one at https://myaccount.google.com/apppasswords
#   3. Use that 16-character value as SMTP_PASS below.
# Never hardcode the password anywhere in code — this env var is the only
# place it should live, and .env is gitignored.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=your-gmail@gmail.com

# ---------------------------------------------------------------------------
# Company details — used on generated documents
# ---------------------------------------------------------------------------
COMPANY_NAME=Simeli ERP
COMPANY_ADDRESS=
COMPANY_EMAIL=
COMPANY_PHONE=
DEFAULT_VAT_RATE=0

# ---------------------------------------------------------------------------
# "Sign in with Google" — USER LOGIN. Distinct from CONNECTOR_GOOGLE_CLIENT_ID
# below, which is the unrelated AI Drive-connector feature (data access, not
# identity) — do not reuse one client for both.
#
# Only a Client ID is needed here, no secret: this uses Google Identity
# Services' ID-token flow (the frontend button hands the backend a signed
# token, verified against Google's own public keys) rather than a
# server-redirect exchange.
#
# Create at Google Cloud Console -> APIs & Services -> Credentials -> Create
# Credentials -> OAuth client ID -> Web application. Authorized JavaScript
# origins: https://embmis.com (covers both the landing page and the ERP —
# they're the same origin in production, ERP served at /platform), plus
# http://localhost:3000 and http://localhost:5173 for local testing.
# ---------------------------------------------------------------------------
GOOGLE_LOGIN_CLIENT_ID=

# ---------------------------------------------------------------------------
# App connectors (Google Drive, Microsoft 365, Xero, Salesforce, ...)
#
# Set these ONCE per server and everyone using it just clicks "Sign in" — they
# never see a client ID. This is how hosted AI products do it: the operator
# registers one OAuth application, users only ever meet a consent screen.
# Leave them unset and each connection asks an admin to paste credentials
# instead, which is fine for a single user but wrong for a team.
#
# The redirect / callback URL to register with every provider is:
#   <BASE_URL>/api/connector-oauth/callback
#
# One pair per provider you want to offer; the key matches the provider id.
# CONNECTOR_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# CONNECTOR_GOOGLE_CLIENT_SECRET=GOCSPX-...
# CONNECTOR_MICROSOFT_CLIENT_ID=
# CONNECTOR_MICROSOFT_CLIENT_SECRET=
# CONNECTOR_XERO_CLIENT_ID=
# CONNECTOR_XERO_CLIENT_SECRET=
# CONNECTOR_QUICKBOOKS_CLIENT_ID=
# CONNECTOR_QUICKBOOKS_CLIENT_SECRET=
# CONNECTOR_SALESFORCE_CLIENT_ID=
# CONNECTOR_SALESFORCE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Mailbox system — company/user @embmis.com addresses
#
# Every company gets an auto-provisioned company@embmis.com mailbox on
# creation; admins can provision one per user. Message bodies/attachments are
# stored in Cloudflare R2 (S3-compatible, free tier), not on local disk.
# ---------------------------------------------------------------------------
MAIL_DOMAIN=example.com
MAILBOX_QUOTA_MB=50

# Cloudflare R2. Create a bucket + API token at dash.cloudflare.com -> R2.
# R2_ACCOUNT_ID is the subdomain of the endpoint URL R2 shows you.
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=embmis-mail

# Shared secret the Cloudflare Email Worker sends as
# X-Mailbox-Webhook-Secret when POSTing an inbound message to
# /api/mailboxes/webhook/inbound. Generate with: openssl rand -hex 32
MAILBOX_WEBHOOK_SECRET=

# Resend — outbound relay for @embmis.com mail (Cloudflare only receives).
# Create a free account at resend.com, verify embmis.com as a sending
# domain, create an API key.
RESEND_API_KEY=
# Svix signing secret for Resend's inbound-mail webhook (POST
# /api/mailboxes/webhook/resend-inbound, event email.received) — shown once
# when you create the webhook via the Resend API/dashboard.
RESEND_WEBHOOK_SECRET=
