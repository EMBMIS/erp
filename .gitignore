# Environment variables
#
# backend/.env is tracked on purpose (owner decision, private repo): it is the
# deployment's real configuration and is shipped in the Cloud Run image, so it
# needs to be in the repo the image builds from.
#
# Consequence worth remembering: git history is permanent. Editing a key here
# later does not remove the old value from history, and making this repo public
# would expose every secret it has ever held. Rotating means rotating at the
# provider, not just changing the file.
.env
.env.local
!backend/.env

# Dependencies
node_modules/
*/node_modules/

# Build outputs
dist/
build/
*/dist/
*/build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
# Editor/tooling junk
vite.config.js.timestamp-*
*/vite.config.js.timestamp-*
*.backup

# Obsidian per-user workspace
vault/.obsidian/workspace.json

# Documents generated by the AI (bytes on disk; the DB row is the record)
backend/exports/ai-documents/

# Database backups (backend/scripts/backup.js) — large binary dumps, not source
backups/*.sql.gz

# AI agent session state and transcripts - local scratch, not source
.codewhale/

# Local scratch from the i18n migration
tmp_shell_runner/
__pycache__/
frontend/scripts/_i18n_chunks/
frontend/remaining_toasts.txt

backend/.env
.env.production
.env.*.local

# the desktop app keeps its icon and macOS entitlements here
!desktop/build/

# Working output of scripts/i18n-export.cjs (keep only the instructions)
frontend/i18n-export/*
!frontend/i18n-export/README.md
!frontend/i18n-export/TRANSLATOR-PROMPT.md
